# flow-backend-python environment configuration. Copy to `.env` and fill in.
# Mirrors apps/flow-backend/.env.example so both backends can share one DB.

# HTTP server. Defaults to 4001 so it can run side-by-side with the Node
# backend (which occupies 4000) during the migration period.
PORT=4001
HOST=0.0.0.0
NODE_ENV=development

# Database connection string (same as the Node/Prisma backend).
# Example (MySQL, matching Prisma schema):
#   mysql://flowgram:flowgram@localhost:3306/flowgram
DATABASE_URL=mysql://flowgram:flowgram@localhost:3306/flowgram

# 32-byte base64 master key for encrypting secrets at rest. MUST match the
# Node backend's FLOWGRAM_ENCRYPTION_KEY for enc:: payloads to decrypt across
# backends. Generate with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
FLOWGRAM_ENCRYPTION_KEY=

# Comma-separated allowed editor origins (CORS).
CORS_ORIGIN=http://localhost:3000
