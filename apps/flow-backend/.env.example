# flow-backend environment configuration. Copy to `.env` and fill in.

# HTTP server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# MySQL connection string (Prisma). Example for a local docker mysql:
#   mysql://flowgram:flowgram@localhost:3306/flowgram
DATABASE_URL=mysql://flowgram:flowgram@localhost:3306/flowgram

# 32-byte base64 master key for encrypting secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FLOWGRAM_ENCRYPTION_KEY=

# Comma-separated allowed editor origins (CORS).
CORS_ORIGIN=http://localhost:3000
